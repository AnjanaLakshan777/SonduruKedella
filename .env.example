# =============================================================================
# Sonduru Kedella — environment configuration TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in the values:
#     cp .env.example .env
#
# `.env` is the single source of configuration for local development. It is read by:
#   - Docker Compose (compose.yaml) for variable substitution
#   - Spring Boot, when run outside Docker (spring.config.import in
#     backend/src/main/resources/application.properties)
#
# Rules:
#   - Never commit `.env`. It is git-ignored. Only this template is tracked.
#   - Never put real credentials in this template.
#   - Production credentials MUST differ from development ones and must be
#     supplied securely (secret manager / deployment environment), never via
#     a committed file or a Docker image.
#   - Do not wrap values in quotes: Spring Boot reads this file as a
#     .properties file and would keep the quotes as part of the value.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=sonduru_kedella
POSTGRES_USER=sonduru_app
# Development-only password. Generate one, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-dev-only

# Host-side port mapped to the container's 5432 (bound to 127.0.0.1 only).
# 5433 avoids clashing with a PostgreSQL already installed on the host.
POSTGRES_HOST_PORT=5433

# --- Backend (Spring Boot) ---------------------------------------------------
# Host-side port for the API (container listens on 8080).
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Frontend (Vite dev server) ----------------------------------------------
# Host-side port for the UI (container listens on 5173).
FRONTEND_PORT=5173
# API base URL as seen BY THE BROWSER (not by a container), so it uses the
# host's localhost and BACKEND_PORT. Public value; never put secrets in VITE_*.
VITE_API_BASE_URL=http://localhost:8080/api/v1
