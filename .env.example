# Local development settings. Copy to .env and set a password; never commit .env.
# Leave values unquoted: Spring Boot also reads this file as a properties file.

POSTGRES_DB=sonduru_kedella
POSTGRES_USER=sonduru_app
POSTGRES_PASSWORD=change-me
# Host port; 5432 is often taken by a local PostgreSQL install.
POSTGRES_HOST_PORT=5433

BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

FRONTEND_PORT=5173
# Browser-facing API URL. Public, so never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8080/api/v1
