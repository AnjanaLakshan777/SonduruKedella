# syntax=docker/dockerfile:1
# React + Vite frontend — DEVELOPMENT image (Vite dev server with hot reload).
# Build context is the repository root (see compose.yaml). The source is bind-mounted
# at runtime, so this image mainly provides Node and Linux-native node_modules.
# A production image (static build served by a web server) is future work.

FROM node:22-alpine
WORKDIR /app
RUN chown node:node /app
USER node

# Install exactly what package-lock.json specifies.
COPY --chown=node:node frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY --chown=node:node frontend/ ./

EXPOSE 5173
# --host 0.0.0.0 makes the dev server reachable from outside the container.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
